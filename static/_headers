# Cloudflare Pages response headers (www.pressgangmutiny.com)
# Hugo copies static/ into public/, which Cloudflare publishes on push to main.

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  # Report-only first: logs violations in the browser console without blocking.
  # Covers YouTube, Spotify, Apple Podcasts, BandsInTown, Mailchimp, Meta Pixel, Google Fonts.
  # Switch the header name to Content-Security-Policy once a week of browsing shows no violations.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net https://widget.bandsintown.com https://*.bandsintown.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://widget.bandsintown.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://*.bandsintown.com https://www.facebook.com https://connect.facebook.net; frame-src https://bandcamp.com https://www.youtube.com https://www.youtube-nocookie.com https://open.spotify.com https://embed.podcasts.apple.com https://*.bandsintown.com https://www.facebook.com; form-action 'self' https://*.list-manage.com; base-uri 'self'; object-src 'none'; frame-ancestors 'self'

/img/*
  Cache-Control: public, max-age=2592000

/press/*
  Cache-Control: public, max-age=86400
